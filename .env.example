# Reference only. Copy the service-specific examples to the locations in README.md.
# Public browser settings (frontend/.env.local):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_EMULATORS=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_GENERATION_URL=

# Server configuration (functions/.env):
HL_CLIENT_ID=
HL_REDIRECT_URI=
HL_SCOPES=contacts.readonly contacts.write conversations.readonly conversations/message.readonly conversations/message.write calendars.readonly calendars/events.readonly locations.readonly
APP_ORIGIN=
ALLOWED_ORIGINS=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
OPENAI_MODEL=gpt-4.1-mini
MAX_GENERATIONS_PER_HOUR=20
APP_CHECK_REQUIRED=false

# Server secrets: use functions/.secret.local for emulation and Secret Manager for deployment.
HL_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
LLM_API_KEY=
