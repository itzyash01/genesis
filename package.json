{
  "name": "genesis-crm-app-builder",
  "private": true,
  "version": "1.0.0",
  "description": "Secure AI workspace for building CRM-powered applications",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && npm --prefix functions run build",
    "lint": "npm --prefix frontend run lint && npm --prefix functions run lint",
    "emulators": "firebase emulators:start --only auth,functions,firestore",
    "deploy": "firebase deploy --only hosting,functions,firestore:rules,firestore:indexes",
    "test": "npm --prefix functions test && vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "firebase-tools": "^15.34.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  }
}
